<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- ================================ -->
    <!--       Basic Project Setup        -->
    <!-- ================================ -->
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.where2go</groupId>
    <artifactId>where2go-web</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <!-- Spring Boot parent provides dependency management + plugin defaults -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <!-- ================================ -->
    <!--           Java Setup             -->
    <!-- ================================ -->
    <properties>
        <!-- Project uses Java 21 (LTS, required by Spring Boot 3.x) -->
        <java.version>21</java.version>

        <!-- Explicitly configure compiler version -->
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>

        <!-- File encoding -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <!-- ================================ -->
    <!--           Dependencies            -->
    <!-- ================================ -->
    <dependencies>

        <!-- Spring Boot Web Starter -->
        <!-- Provides REST API framework, embedded Tomcat, JSON serialization, etc. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- SQLite JDBC Driver -->
        <!-- Used for caching weather data locally using SQLite + SQL upsert logic -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.45.3.0</version>
        </dependency>

        <!-- org.json: Lightweight JSON parser -->
        <!-- Used for parsing Tomorrow.io API responses -->
        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
            <version>20240303</version>
        </dependency>

        <!-- Weka Machine Learning Library -->
        <!-- Provides the J48 Decision Tree classifier for the recommendation engine -->
        <dependency>
            <groupId>nz.ac.waikato.cms.weka</groupId>
            <artifactId>weka-stable</artifactId>
            <version>3.8.6</version>
        </dependency>

        <!-- Spring Boot Devtools (Optional) -->
        <!-- Enables auto-reload during development; NOT included in production builds -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- Spring Boot Testing Support -->
        <!-- JUnit + MockMVC for testing controllers and services -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        
        <dependency>
            <groupId>nz.ac.waikato.cms.weka</groupId>
            <artifactId>weka-stable</artifactId>
            <version>3.8.6</version>
        </dependency>

    </dependencies>

    <!-- ================================ -->
    <!--              Build               -->
    <!-- ================================ -->
    <build>
        <plugins>

            <!-- Maven Compiler Plugin -->
            <!-- Ensures the project compiles using Java 21 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <release>${java.version}</release>
                </configuration>
            </plugin>

            <!-- Spring Boot Maven Plugin -->
            <!-- Handles building fat JARs, repackaging, and running the app -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>3.3.4</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <!-- Optional: enable layered JAR structure (useful for Docker builds) -->
                    <layers>
                        <enabled>true</enabled>
                    </layers>
                </configuration>
            </plugin>

        </plugins>
    </build>

</project>
